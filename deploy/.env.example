# Copie para deploy/.env e ajuste — NUNCA commite o .env real.

# Domínio público do sistema (sem https://)
DOMAIN=nefron.seudominio.com.br

# Senha do PostgreSQL (gere: openssl rand -hex 16)
DB_PASSWORD=troque-esta-senha

# Segredo dos tokens JWT (gere: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo-por-um-de-64-hex

# VIDaaS (deixe vazio até o credenciamento na Valid → modo simulado)
VIDAAS_CLIENT_ID=
VIDAAS_CLIENT_SECRET=
