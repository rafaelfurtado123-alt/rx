# Copie para .env e ajuste. Todas as variáveis usam o prefixo NEFRON_.
NEFRON_ENVIRONMENT=development
NEFRON_DEBUG=true

# Banco (Supabase Postgres — usado apenas como banco; auth é próprio da API)
NEFRON_DATABASE_URL=postgresql+asyncpg://nefron:nefron@localhost:5432/nefron

# JWT — GERE UM SEGREDO FORTE EM PRODUÇÃO (ex.: openssl rand -hex 32)
NEFRON_JWT_SECRET=troque-em-producao-use-segredo-forte
NEFRON_ACCESS_TOKEN_TTL_MIN=30
NEFRON_REFRESH_TOKEN_TTL_DAYS=7

# 2FA
NEFRON_TOTP_ISSUER=Nefron

# CORS (origens do app Flutter)
NEFRON_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
